{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "GrottoWorks",
    "Audience": "GrottoWorks.Web"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/api/v1/identity/auth/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/api/v1/auth/{**catch-all}" } ]
      },
      "identity-route": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/api/v1/{**catch-all}" } ]
      },
      "parish-route": {
        "ClusterId": "parish",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/parish/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/api/v1/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5180/"
          }
        }
      },
      "parish": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5178/"
          }
        }
      }
    }
  }
}
