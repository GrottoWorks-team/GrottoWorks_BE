        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Purchase Request Approval and Purchase Confirmation Activity Diagram\nskinparam defaultTextAlignment center\nskinparam wrapWidth 160\n|Material Officer|\nstart\n:View material shortages;\n:Create purchase request;\n:Add purchase request items;\n:Submit purchase request;\n|System|\n:Validate request items;\nif (Has at least one item?) then (Yes)\nelse (No)\n  :Show missing item error;\n  detach\nendif\n:Validate requested quantities;\nif (Quantities are valid?) then (Yes)\nelse (No)\n  :Show quantity error;\n  detach\nendif\n:Calculate estimated total;\n:Save purchase request;\n:Set request status to Submitted;\n|Parish Christmas Committee|\n:Review purchase request;\nif (Approve request?) then (Yes)\n  |System|\n  :Set request status to Approved;\n  :Save approved by user and approved time;\nelse (No)\n  |System|\n  :Set request status to Rejected;\n  detach\nendif\n|Buyer or Volunteer|\n:Buy materials;\n:Enter purchase information;\n:Upload receipt photo;\n:Enter purchase items;\n|Material Officer|\n:Check delivered materials and receipt;\nif (Purchase information is valid?) then (Yes)\nelse (No)\n  |System|\n  :Request purchase revision;\n  detach\nendif\n|System|\n:Confirm purchase;\n:Save confirmed by user and confirmed time;\n:Create material transactions;\n:Update stock summary;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1RuOQkMxXsnQus1tGjYM-443">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
