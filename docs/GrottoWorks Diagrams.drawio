        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Assign Volunteer to Task Activity Diagram\nskinparam defaultTextAlignment center\nskinparam wrapWidth 160\n|Work Area Leader|\nstart\n:Open task list;\n:Select task;\n|System|\n:Display available volunteers;\n|Work Area Leader|\n:Select volunteer;\n|System|\n:Check volunteer status;\nif (Volunteer is active?) then (Yes)\nelse (No)\n  :Show invalid volunteer error;\n  detach\nendif\n:Check volunteer skills;\nif (Volunteer has required skills?) then (Yes)\nelse (No)\n  :Show skill mismatch warning;\n  detach\nendif\n:Check existing assignment;\nif (Volunteer already assigned?) then (No)\nelse (Yes)\n  :Show duplicate assignment error;\n  detach\nendif\n:Create task assignment;\n:Set assignment status to Pending;\n:Notify volunteer;\n|Volunteer|\n:View assigned task;\nif (Accept task?) then (Yes)\n  |System|\n  :Set assignment status to Accepted;\nelse (No)\n  |System|\n  :Set assignment status to Rejected;\nendif\n:Save response time;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1RuOQkMxXsnQus1tGjYM-240">
