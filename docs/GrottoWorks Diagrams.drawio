        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Attendance Check-in Check-out and Correction Activity Diagram\nskinparam defaultTextAlignment center\nskinparam wrapWidth 160\n|Volunteer|\nstart\n:Open task assignment;\n:Select Check-in;\n|System|\n:Validate task assignment;\nif (Assignment is valid?) then (Yes)\nelse (No)\n  :Show invalid assignment error;\n  detach\nendif\n:Check existing check-in;\nif (Already checked in?) then (Yes)\n  :Show already checked in message;\nelse (No)\n  :Create attendance with check-in time;\nendif\n|Volunteer|\n:Work on assigned task;\n:Select Check-out;\n|System|\n:Check check-in record;\nif (Has check-in record?) then (Yes)\nelse (No)\n  :Show missing check-in error;\n  detach\nendif\n:Save check-out time;\n:Calculate working hours;\n:Update attendance status;\n|Volunteer|\nif (Need attendance correction?) then (Yes)\n  :Submit correction reason;\nelse (No)\n  detach\nendif\n|System|\n:Send correction request;\n|Work Area Leader or Committee|\n:Review correction request;\nif (Approve correction?) then (Yes)\n  |System|\n  :Update working hours;\n  :Save corrected by user and corrected time;\n  :Save correction reason;\nelse (No)\n  |System|\n  :Keep original attendance record;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1RuOQkMxXsnQus1tGjYM-704">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
