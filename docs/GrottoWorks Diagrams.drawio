        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Submit Progress and Approve Task Completion Activity Diagram\nskinparam defaultTextAlignment center\nskinparam wrapWidth 160\n|Volunteer|\nstart\n:Open assigned task;\n:Select Update Progress;\n:Enter progress percent and progress note;\n:Upload progress evidence;\n|System|\n:Validate assignment;\nif (Assignment is valid?) then (Yes)\nelse (No)\n  :Show permission error;\n  detach\nendif\n:Validate progress percent;\nif (Progress percent is between 0 and 100?) then (Yes)\nelse (No)\n  :Show progress error;\n  detach\nendif\n:Create task progress;\nif (Has evidence files?) then (Yes)\n  :Save progress evidence;\nelse (No)\nendif\n:Notify work area leader;\n|Work Area Leader|\n:Review progress note and evidence;\nif (Progress is 100 percent?) then (Yes)\nelse (No)\n  :Acknowledge progress update;\n  detach\nendif\n:Review task completion;\nif (Approve completion?) then (Yes)\n  |System|\n  :Save approved by user and approved time;\n  :Set task status to Completed;\nelse (No)\n  |System|\n  :Request revision from volunteer;\nendif\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1RuOQkMxXsnQus1tGjYM-634">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
