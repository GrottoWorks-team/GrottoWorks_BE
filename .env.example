# Copy to .env (docker compose reads it automatically) and adjust.
# Never commit the real .env file.
# NOTE: these names are substituted into docker-compose.override.yml (${NAME});
# compose maps them to the .NET config keys (Jwt__SigningKey, MessageBroker__*, ...) itself.

# --- Postgres (superuser used by the init script and connection strings) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- RabbitMQ (also used as MessageBroker__UserName/Password for the services) ---
RABBITMQ_DEFAULT_USER=grottoworks
RABBITMQ_DEFAULT_PASS=grottoworks

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=grottoworks
MINIO_ROOT_PASSWORD=grottoworks_minio_1234

# --- Shared JWT signing key (HS256, MUST be >= 32 chars) — Identity + Gateway ---
JWT_SIGNING_KEY=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG

# --- Identity service: initial ADMIN password ---
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
