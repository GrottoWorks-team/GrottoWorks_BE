{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "GrottoWorks",
    "Audience": "GrottoWorks.Web"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "identity-users-route": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "identity-skills-route": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/skills/{**catch-all}"
        }
      },
      "identity-admin-users-route": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/admin/users/{**catch-all}"
        }
      },
      "identity-roles-route": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/roles"
        }
      },
      "resource-material-categories-route": {
        "ClusterId": "resource",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/material-categories/{**catch-all}"
        }
      },
      "resource-materials-route": {
        "ClusterId": "resource",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/materials/{**catch-all}"
        }
      },
      "resource-work-area-material-requirements-route": {
        "ClusterId": "resource",
        "AuthorizationPolicy": "authenticated",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/work-areas/{workAreaId}/material-requirements"
        }
      },
      "resource-material-requirements-route": {
        "ClusterId": "resource",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/material-requirements/{**catch-all}"
        }
      },
      "resource-inventory-route": {
        "ClusterId": "resource",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/inventory/{**catch-all}"
        }
      },
      "resource-work-area-shortages-route": {
        "ClusterId": "resource",
        "AuthorizationPolicy": "authenticated",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/work-areas/{workAreaId}/shortages"
        }
      },
      "resource-season-material-needs-route": {
        "ClusterId": "resource",
        "AuthorizationPolicy": "authenticated",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/seasons/{seasonId}/material-needs"
        }
      },
      "resource-purchase-requests-route": {
        "ClusterId": "resource",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/purchase-requests/{**catch-all}"
        }
      },
      "task-work-area-tasks-route": {
        "ClusterId": "task",
        "AuthorizationPolicy": "authenticated",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/work-areas/{workAreaId}/tasks"
        }
      },
      "task-task-detail-route": {
        "ClusterId": "task",
        "AuthorizationPolicy": "authenticated",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/tasks/{taskId}"
        }
      },
      "parish-parishes-route": {
        "ClusterId": "parish",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/parishes/{**catch-all}"
        }
      },
      "parish-communities-route": {
        "ClusterId": "parish",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/communities/{**catch-all}"
        }
      },
      "parish-work-area-categories-route": {
        "ClusterId": "parish",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/work-area-categories/{**catch-all}"
        }
      },
      "parish-seasons-route": {
        "ClusterId": "parish",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/seasons/{**catch-all}"
        }
      },
      "parish-work-areas-route": {
        "ClusterId": "parish",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/work-areas/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5180/"
          }
        }
      },
      "parish": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5178/"
          }
        }
      },
      "resource": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5183/"
          }
        }
      },
      "task": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5184/"
          }
        }
      }
    }
  }
}
