{
  "ConnectionStrings": {
    "ParishCoordinationDatabase": "Host=localhost;Port=5432;Database=parish_db;Username=postgres"
  },
  "Jwt": {
    "Issuer": "GrottoWorks",
    "Audience": "GrottoWorks.Web"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "IdentityClient": {
    "BaseAddress": "http://localhost:6100/"
  },
  "TaskExecutionClient": {
    "BaseAddress": "http://localhost:6104/"
  },
  "LifecycleEvents": {
    "Enabled": false,
    "RecoveryIntervalSeconds": 30
  },
  "ScopeDelivery": {
    "BrokerPrimaryEnabled": false,
    "HttpRollbackEnabled": false
  },
  "PlanningEvents": {
    "DispatchEnabled": false,
    "ReconcileIntervalMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
