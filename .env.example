# Copy to .env (docker compose reads it automatically) and adjust.
# Never commit the real .env file.
# NOTE: these names are substituted into docker-compose.override.yml (${NAME});
# compose maps them to the .NET config keys (Jwt__SigningKey, MessageBroker__*, ...) itself.

# --- Postgres (superuser used by the init script and connection strings) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=15432

# --- RabbitMQ (also used as MessageBroker__UserName/Password for the services) ---
RABBITMQ_DEFAULT_USER=grottoworks
RABBITMQ_DEFAULT_PASS=grottoworks

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=grottoworks
MINIO_ROOT_PASSWORD=grottoworks_minio_1234

# --- Shared JWT signing key (HS256, MUST be >= 32 chars) — Identity + Gateway ---
JWT_SIGNING_KEY=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG

# --- Identity service: initial ADMIN password ---
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Service-to-service key for /internal/** endpoints (>= 32 chars, F-IDN-09) ---
# Callers (Parish, Task, Resource, ...) send it in the X-Internal-Api-Key header.
INTERNAL_API_KEY=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG

# Dedicated allowlisted system-export credentials; keep separate from ordinary internal API calls.
SYSTEM_EXPORT_API_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_STRING_AT_LEAST_32_CHARS
# Optional telemetry export; planning scope delivery uses RabbitMQ.
OBSERVABILITY_ENABLED=false
# Only the isolated --profile backup worker receives read-only source database credentials and encryption key.
# Provision the roles using docker/postgres/backup-role.sql before enabling the profile.
BACKUP_DB_USER=grottoworks_backup
BACKUP_DB_PASSWORD=
BACKUP_JOB_DB_USER=grottoworks_backup_jobs
BACKUP_JOB_DB_PASSWORD=
# Base64-encoded random 32 bytes. Never commit the real value; retain it securely for restore.
GROTTOWORKS_BACKUP_KEY=
BACKUP_KEY_ID=local-v1
